<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 设备到设备迁移不受 allowBackup="false" 控制（docs/002 §5.3）。
  凭据密文、快照（含 Cookie）与电费缓存一律不参与云备份 / 迁移；
  这些都是本机重建即可得到的数据，排除后不会丢功能。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
